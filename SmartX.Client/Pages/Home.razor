@page "/"

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5">Smart-X IoT Mesh Ecosystem</h1>
        <p class="text-muted lead">Part 2 — Real-Time Processing and Device Management</p>
    </div>

    <div class="row g-4 justify-content-center">
        <!-- Pillar 1 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="display-4 mb-3">📡</div>
                    <h4 class="fw-bold">Sensor Ingestion</h4>
                    <p class="text-muted mt-2">Register sensors, ingest telemetry, and monitor live anomalies.</p>
                    <a href="/dashboard" class="btn btn-success w-100 mt-3 py-2 fw-bold">Open Dashboard</a>
                </div>
            </div>
        </div>

        <!-- Pillar 2 -->
        <div class="col-md-4">
            <div class="card h-100 border-primary shadow-sm" style="border-width: 2px;">
                <div class="card-body text-center p-4">
                    <div class="display-4 mb-3">⚡</div>
                    <h4 class="fw-bold text-primary">Command Stream</h4>
                    <p class="text-muted mt-2">Issue manual overrides, view live queues, and trigger predictive actions.</p>
                    <a href="/command-stream" class="btn btn-primary w-100 mt-3 py-2 fw-bold">Open Command Stream</a>
                </div>
            </div>
        </div>

        <!-- Pillar 3 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 bg-light shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="display-4 mb-3">🕸️</div>
                    <h4 class="fw-bold text-secondary">Network Topology</h4>
                    <p class="text-muted mt-2">Visualise mesh connections and node routing paths.</p>
                    <a href="/topology" class="btn btn-outline-secondary w-100 mt-3 py-2 fw-bold">View Placeholder</a>
                </div>
            </div>
        </div>
    </div>
</div>